# Copy to .env.local and replace with YOUR Firebase Console Web App configuration.
# These are placeholders, not a working Firebase project.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_ADMIN_UID=YOUR_SINGLE_ADMIN_UID

# Never place passwords, service-account JSON or private keys in VITE_* variables.
