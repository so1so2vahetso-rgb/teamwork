{
  "name": "teamwork",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:emulator": "vite --host 127.0.0.1 --mode emulator --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/lib/firebaseConfig.test.js src/features/auth/accountRole.test.js src/features/tasks/taskViewModel.test.js",
    "check:firebase": "node scripts/check-firebase-config.mjs",
    "test:rules": "firebase emulators:exec --project demo-teamwork --only auth,firestore \"node --test --test-concurrency=1 firebase/tests/*.test.js\"",
    "emulators": "firebase emulators:start --project demo-teamwork --only auth,firestore",
    "deploy": "firebase deploy --project teamworl-3021a --only firestore:rules,firestore:indexes,hosting",
    "start": "node scripts/start-local.mjs"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "firebase-tools": "^15.36.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
